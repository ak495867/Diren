{
  "name": "diren",
  "version": "1.0.0",
  "description": "Local context caching tool to reduce AI API costs by up to 10x with advanced compression",
  "main": "dist/index.js",
  "bin": {
    "diren": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "cli": "ts-node src/cli.ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=__tests__ --testNamePattern=\"(SemanticScorer|FastMemoryStore|ModelPool|CacheManager)\\.test\"",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:coverage": "jest --coverage",
    "test:all": "bash scripts/run-tests.sh --all",
    "test:watch": "jest --watch",
    "dashboard": "npm run build && npm run cli dashboard",
    "setup": "npm run build && npm link",
    "benchmark": "node scripts/benchmark.js",
    "intelligence-benchmark": "node scripts/intelligence-benchmark.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "ai",
    "caching",
    "api",
    "cost-reduction",
    "proxy",
    "compression",
    "dashboard",
    "claude-cli",
    "cursor",
    "openai",
    "anthropic",
    "intelligence",
    "semantic",
    "ml"
  ],
  "author": "Diren Contributors",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/sqlite3": "^3.1.8",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/diren-ai/diren.git"
  },
  "homepage": "https://github.com/diren-ai/diren#readme",
  "bugs": {
    "url": "https://github.com/diren-ai/diren/issues"
  }
}
